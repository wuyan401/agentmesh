{
  "name": "agentmesh",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "AgentMesh — an operating system for heterogeneous CLI agents to collaborate as a team",
  "engines": {
    "node": ">=22.6.0"
  },
  "bin": {
    "mesh": "./cli/mesh.ts"
  },
  "scripts": {
    "mesh": "node cli/mesh.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test tests/unit/*.test.ts tests/redteam/*.test.ts",
    "test:unit": "node --test tests/unit/*.test.ts",
    "test:redteam": "node --test tests/redteam/*.test.ts",
    "prove:logbook": "node tests/prove/export-logbook.ts",
    "prove:ui": "python tests/prove/verify-dashboard.py"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
